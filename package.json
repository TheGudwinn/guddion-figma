{
  "name": "guddion_mcp_figma",
  "version": "1.0.0",
  "description": "Локальный MCP-сервер для работы с Figma — альтернатива официальному Figma MCP-коннектору, без искусственных лимитов на стороне инструмента.",
  "main": "dist/server.js",
  "bin": {
