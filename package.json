  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheGudwinn/guddion-figma.git"
  },
  "homepage": "https://github.com/TheGudwinn/guddion-figma#readme",
  "bugs": {
    "url": "https://github.com/TheGudwinn/guddion-figma/issues"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
